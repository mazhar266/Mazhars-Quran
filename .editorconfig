root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.{xml,toml,yml,yaml,json}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Verbatim third-party files: never reformat.
[shared/src/commonMain/composeResources/files/quran-uthmani.txt]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset

[docs/licenses/*]
trim_trailing_whitespace = unset
